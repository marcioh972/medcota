# Copie para .env e ajuste. NUNCA commite o .env.
AMBIENTE=desenvolvimento            # desenvolvimento | teste | producao
DATABASE_URL=sqlite:///./medcota.db
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
JWT_EXPIRA_HORAS=8
BCRYPT_ROUNDS=12

# Lista em JSON
CORS_ORIGENS=["http://localhost:5173","http://localhost:3000"]

ALCADA_APROVACAO=5000
VALIDADE_COTACAO_H=48
FRETE_PADRAO=45
HORARIO_CORTE=17:00
FUSO_HORARIO=America/Maceio

CODIGO_VALIDADE_DIAS=7
LOGIN_MAX_FALHAS=5
LOGIN_BLOQUEIO_MIN=30
RATE_LIMIT_ATIVO=true
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_CADASTRO=5/minute
RATE_LIMIT_PUBLICO=60/minute
LOG_NIVEL=INFO

# Recebimento de NF-e
NFE_MAX_BYTES=2000000          # tamanho máximo do XML enviado
